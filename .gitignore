# VYNX QR — .gitignore
#
# Only source and the files a build genuinely needs are tracked. Everything that is
# generated, machine-local or secret is ignored here, so `git status` stays readable
# and no local setup leaks into a commit.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/

# `package-lock.json` is intentionally tracked: it is what makes an install
# reproducible, which matters more here than a shorter clone.

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
# Cargo target directories. Matched at any depth, because the workspace has more
# than one crate: core/target, bridge/target and the Tauri shell's src-tauri/target.
target/
# Generated by `tauri-build` on every run; also contains absolute paths from the
# machine that built it.
src-tauri/gen/
coverage/
# CMake and CPack output.
build/
out/
CMakeUserPresets.json
# Installer artifacts are published as GitHub Releases, never committed.
/releases/

# ---------------------------------------------------------------------------
# Agent and editor tooling state
# ---------------------------------------------------------------------------
# Local session state and agent plans: personal to this checkout.
.kilo/
.kilocode/
.opencode/
# Keep the recommended extensions, drop everything else local to one machine.
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/

# ---------------------------------------------------------------------------
# Secrets and machine configuration
# ---------------------------------------------------------------------------
# Code signing material for the release installers must never be committed.
*.pem
*.p12
*.pfx
*.key
*.keystore
# A developer may keep their own MSVC toolchain overrides here.
.cargo/
# Local overrides that must not silently change the committed build.
.env
.env.*
!.env.example
*.local

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
__pycache__/
*.pyc
*.bak
*.orig
*.rej
*~
# Crash dumps from a crashing build or a crashing app.
*.stackdump

# ---------------------------------------------------------------------------
# Operating system noise
# ---------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS (harmless to keep on Windows, noisy in a shared repo)
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Editors, all platforms
*.swp
*.swo
